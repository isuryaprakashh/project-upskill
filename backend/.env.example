# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
# Set STORE=memory to try the API without a database (data is lost on restart).
# STORE=memory
# From MongoDB Atlas: Database > Connect > Drivers. Change the password you shared earlier first.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/
MONGODB_DB=upskill
# Two long random strings. Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# Comma-separated list of sites allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Emails that can open the admin dashboard (comma-separated)
ADMIN_EMAILS=isurya2005@gmail.com
